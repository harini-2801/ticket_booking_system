# Database URL (SQLite for local dev, PostgreSQL for production / Vercel)
DATABASE_URL="file:./dev.db"

# JWT Secret for Authentication
JWT_SECRET="super-secret-ticket-booking-jwt-key-2026"

# Node Environment
NODE_ENV="development"

# Email Configuration (Nodemailer - leave empty to output mock email details to console)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="tickets@ticketmaster-demo.com"

# Next Public Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
